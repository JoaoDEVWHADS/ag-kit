{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag-kit.local/schemas/lifecycle-hooks.schema.json",
  "title": "AG Kit Portable Lifecycle Hook Configuration",
  "description": "Runtime-neutral hook registrations for portable agent lifecycle automation and policy checks.",
  "type": "object",
  "required": ["schemaVersion", "hooks"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "1.0.0"},
    "defaults": {
      "type": "object",
      "properties": {
        "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 600000},
        "failureMode": {"enum": ["fail_closed", "warn", "ignore"]}
      },
      "additionalProperties": false
    },
    "hooks": {
      "type": "array",
      "items": {"$ref": "#/$defs/hook"}
    }
  },
  "$defs": {
    "hook": {
      "type": "object",
      "required": ["id", "event", "handler"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "event": {"$ref": "lifecycle-event.schema.json#/properties/event"},
        "enabled": {"type": "boolean", "default": true},
        "runtime": {
          "enum": [
            "portable",
            "claude-code",
            "codex",
            "cursor",
            "cline",
            "roo-code",
            "gemini-cli",
            "windsurf",
            "openhands"
          ]
        },
        "mode": {"enum": ["blocking", "async"], "default": "blocking"},
        "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 600000},
        "failureMode": {"enum": ["fail_closed", "warn", "ignore"]},
        "matcher": {
          "type": "object",
          "properties": {
            "tool": {"type": "string"},
            "agent": {"type": "string"},
            "path": {"type": "string"},
            "source": {"type": "string"}
          },
          "additionalProperties": false
        },
        "handler": {
          "type": "object",
          "required": ["type", "target"],
          "properties": {
            "type": {"enum": ["command", "http", "mcp", "prompt", "agent"]},
            "target": {"type": "string", "minLength": 1},
            "args": {
              "type": "array",
              "items": {"type": "string"}
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
